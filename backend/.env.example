# Copy to backend/.env and fill in. Never commit the real .env.
PORT=5000
# Use a replica set (MongoDB Atlas, or local `mongod --replSet rs0`) so transactions work.
MONGODB_URI=mongodb://127.0.0.1:27017/ember-and-olive?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
TIMEZONE=Asia/Colombo
