# Copy to backend/.env and fill in. This file is safe to commit; backend/.env is not (it is git-ignored).
NODE_ENV=development
PORT=5000

# Use a replica set (MongoDB Atlas, or local `mongod --replSet rs0`).
# Create a dedicated Atlas database user with readWrite on ember-and-olive only, never an admin user.
MONGODB_URI=mongodb://127.0.0.1:27017/ember-and-olive?replicaSet=rs0

# Website origin(s) allowed to call the API, comma separated. https:// is required in production.
CLIENT_ORIGIN=http://localhost:5173

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start if this is short or still a placeholder.
JWT_SECRET=

TIMEZONE=Asia/Colombo

# Number of reverse proxies in front of the API (0 locally, 1 on Render/Railway/Heroku/Vercel).
# Needed so rate limits and logs see the real visitor IP.
TRUST_PROXY=0
